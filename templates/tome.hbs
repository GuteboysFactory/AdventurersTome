      <div class="at-search-shelf-grid">
        {{#each searchState.recent}}
        <article class="at-search-shelf-card compact">
          <button type="button" class="at-search-shelf-open" data-action="{{action}}" {{#if actor}}data-actor-id="{{id}}"{{else}}data-journal-id="{{id}}"{{/if}} data-ref-key="{{refKey}}">
            <span class="at-search-shelf-icon">{{#if img}}<img src="{{img}}" alt="">{{else}}<i class="fa-solid {{icon}}"></i>{{/if}}</span>
            <span><em>{{category}}</em><strong>{{name}}</strong><small>{{meta}}</small></span>
          </button>
        </article>
        {{/each}}
      </div>
    </section>
    {{/if}}

    <section class="at-search-toolbox">
      <div class="at-search-box"><i class="fa-solid fa-magnifying-glass"></i><input type="search" data-at-search value="{{searchState.query}}" placeholder="Search names, summaries, categories…" autocomplete="off"><kbd>/</kbd></div>
      <div class="at-search-filters" role="group" aria-label="Search filters">
        {{#each searchState.filters}}<button type="button" class="{{#if active}}active{{/if}}" data-at-search-filter="{{key}}"><i class="fa-solid {{icon}}"></i><span>{{label}}</span><em>{{count}}</em></button>{{/each}}
      </div>
    </section>

    <section class="at-search-index">
      <header><div><span class="at-kicker">Tome index</span><h2>Results</h2></div><strong data-at-search-count>{{searchState.total}} results</strong></header>
