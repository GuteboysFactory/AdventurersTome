        {{#if profileView.hasCustomLinks}}<section class="at-custom-link-bar"><span><i class="fa-solid fa-link"></i> Shortcuts</span><div>{{#each profileView.customLinks}}<button type="button" class="at-secondary" data-action="openCustomLink" data-link-target="{{target}}"><i class="fa-solid {{icon}}"></i> {{label}}</button>{{/each}}</div></section>{{/if}}

{{#if isGM}}{{#if profileView.access.openNotes.length}}<div class="at-gm-note-stack at-detail-gm-note">{{#each profileView.access.openNotes}}<div class="at-gm-note {{#if pinned}}is-pinned{{/if}}"><i class="fa-solid {{typeIcon}}"></i><div><strong>{{typeLabel}} · {{title}}</strong><p>{{body}}</p>{{#if trigger}}<small><i class="fa-solid fa-bell"></i> {{trigger}}</small>{{/if}}{{#if sessionTarget}}<small><i class="fa-solid fa-calendar"></i> Session {{sessionTarget}}</small>{{/if}}</div></div>{{/each}}</div>{{/if}}{{/if}}
