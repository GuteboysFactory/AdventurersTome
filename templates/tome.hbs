  {{#if isSearch}}
  <main class="at-page at-search-page">
    <section class="at-page-heading at-search-heading"><span class="at-kicker">Find anything</span><h1>Search the Tome</h1><p>Sessions, quests, characters, people, places, factions, items, lore, and rules — all in one index.</p></section>

    {{#if searchState.hasFavorites}}
    <section class="at-search-shelf at-search-favorites">
      <div class="at-search-shelf-heading"><div><i class="fa-solid fa-star"></i><h2>Favorites</h2></div><span>{{searchState.favorites.length}}</span></div>
      <div class="at-search-shelf-grid">
        {{#each searchState.favorites}}
        <article class="at-search-shelf-card">
          <button type="button" class="at-search-shelf-open" data-action="{{action}}" {{#if actor}}data-actor-id="{{id}}"{{else}}data-journal-id="{{id}}"{{/if}} data-ref-key="{{refKey}}">
