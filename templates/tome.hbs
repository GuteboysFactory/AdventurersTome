        {{#if worldProfileView.campaignActors.length}}<div><h3>Characters</h3><div class="at-link-chip-list">{{#each worldProfileView.campaignActors}}<button type="button" data-action="openProfile" data-actor-id="{{id}}"><i class="fa-solid fa-user"></i>{{name}}</button>{{/each}}</div></div>{{/if}}
