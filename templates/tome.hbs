            <span class="at-search-result-copy"><em>{{category}}{{#if meta}} · {{meta}}{{/if}}</em><strong>{{name}}</strong><small>{{summary}}</small></span>
            <i class="fa-solid fa-chevron-right"></i>
          </button>
