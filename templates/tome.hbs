<div class="at-shell {{settings.themeClass}}">
  <header class="at-topbar">
    <button class="at-brand" type="button" data-action="navigate" data-tab="home">
      {{#if settings.hasLogo}}<span class="at-brand-logo"><img src="{{settings.logoUrl}}" alt="Campaign logo"></span>{{else}}<span class="at-brand-icon"><i class="fa-solid fa-book-open"></i></span>{{/if}}
      <span class="at-brand-text"><small>ADVENTURER'S</small><strong>TOME</strong></span>
    </button>

    <nav class="at-nav" aria-label="Adventurer's Tome navigation">
      <button type="button" class="{{#if isHome}}active{{/if}}" data-action="navigate" data-tab="home"><i class="fa-solid fa-house"></i><span>Home</span></button>
      {{#if settings.nav.sessions}}<button type="button" class="{{#if isSessions}}active{{/if}}" data-action="navigate" data-tab="sessions"><i class="fa-solid fa-book-open"></i><span>Sessions</span></button>{{/if}}
      {{#if settings.nav.quests}}<button type="button" class="{{#if isQuestNavActive}}active{{/if}}" data-action="navigate" data-tab="quests"><i class="fa-solid fa-diamond"></i><span>Quests</span></button>{{/if}}
      {{#if settings.nav.group}}<button type="button" class="{{#if isGroupNavActive}}active{{/if}}" data-action="navigate" data-tab="group"><i class="fa-solid fa-users"></i><span>Group</span></button>{{/if}}
      {{#if settings.nav.world}}<button type="button" class="{{#if isWorldNavActive}}active{{/if}}" data-action="navigate" data-tab="world"><i class="fa-solid fa-earth-europe"></i><span>World</span></button>{{/if}}
      {{#if settings.nav.rules}}<button type="button" class="{{#if isRulesNavActive}}active{{/if}}" data-action="navigate" data-tab="rules"><i class="fa-solid fa-scroll"></i><span>Rules</span></button>{{/if}}
      {{#if settings.nav.search}}<button type="button" class="{{#if isSearch}}active{{/if}}" data-action="navigate" data-tab="search"><i class="fa-solid fa-magnifying-glass"></i><span>Search</span></button>{{/if}}
    </nav>

    <div class="at-gm-top-actions">
      <button type="button" class="at-icon-button {{#if isManual}}active{{/if}}" title="Adventurer's Tome Manual" data-action="openManual"><i class="fa-solid fa-circle-question"></i></button>
      {{#if isGM}}
        <button type="button" class="at-icon-button {{#if isGmDashboard}}active{{/if}}" title="Next Session Dashboard" data-action="openGmDashboard"><i class="fa-solid fa-wand-magic-sparkles"></i></button>
        <button type="button" class="at-icon-button {{#if isQuickCapture}}active{{/if}}" title="Quick Capture" data-action="openQuickCapture"><i class="fa-solid fa-bolt"></i></button>
        <button type="button" class="at-icon-button {{#if isRevealQueue}}active{{/if}}" title="Reveal Queue" data-action="openRevealQueue"><i class="fa-solid fa-eye"></i>{{#if revealQueue.queuedCount}}<span class="at-icon-badge">{{revealQueue.queuedCount}}</span>{{/if}}</button>
        <button type="button" class="at-icon-button" title="GM Notebook" data-action="openNotebook"><i class="fa-solid fa-note-sticky"></i></button>
        <button type="button" class="at-icon-button at-settings-critical {{#if isSettings}}active{{/if}}" title="Campaign Settings" data-action="openSettings"><i class="fa-solid fa-gear"></i></button>
      {{/if}}
    </div>
  </header>

  {{#if isHome}}
  <main class="at-home {{settings.homeModeClass}} {{settings.homeHeroLayoutClass}} {{settings.homeHeroHeightClass}} {{settings.homeHeroShadeClass}} {{settings.homeHeroFocusClass}} {{#unless settings.homeCardsVisible}}at-home-no-cards {{/unless}}{{#unless homeSidebarVisible}}at-home-no-sidebar{{/unless}}">
    {{#if homeSidebarVisible}}
    <aside class="at-sidebar at-panel-dark">
      {{#if settings.homeSidebarCampaign}}
      <section class="at-campaign-card">
        <span class="at-kicker">Campaign</span>
        <h2>{{settings.campaignTitle}}</h2>
        <p>{{settings.campaignSubtitle}}</p>
        <div class="at-compass"><i class="fa-regular fa-compass"></i></div>
        <div class="at-status-block"><span>{{settings.sessionLabel}}</span><strong>{{stats.sessions}} played</strong></div>
        <div class="at-status-block"><span>Current Location</span><strong>{{settings.currentLocation}}</strong></div>
      </section>
      {{/if}}

      {{#if settings.homeSidebarQuickLinks}}
      <section class="at-quick-links">
        <span class="at-kicker">Quick Links</span>
        {{#if settings.nav.sessions}}<button type="button" data-action="navigate" data-tab="sessions"><i class="fa-regular fa-calendar"></i> Recent Sessions</button>{{/if}}
        {{#if settings.nav.quests}}<button type="button" data-action="navigate" data-tab="quests"><i class="fa-solid fa-diamond"></i> Active Quests</button>{{/if}}
        {{#if settings.nav.group}}<button type="button" data-action="navigate" data-tab="group"><i class="fa-solid fa-users"></i> Group</button>{{/if}}
        {{#if settings.nav.world}}<button type="button" data-action="navigate" data-tab="world"><i class="fa-solid fa-location-dot"></i> World & Lore</button>{{/if}}
        {{#if settings.nav.rules}}<button type="button" data-action="navigate" data-tab="rules"><i class="fa-solid fa-scroll"></i> Rules</button>{{/if}}
        {{#if isGM}}<button type="button" data-action="openGmDashboard"><i class="fa-solid fa-wand-magic-sparkles"></i> Next Session</button><button type="button" data-action="openQuickCapture"><i class="fa-solid fa-bolt"></i> Quick Capture</button><button type="button" data-action="openRevealQueue"><i class="fa-solid fa-eye"></i> Reveal Queue{{#if revealQueue.queuedCount}} ({{revealQueue.queuedCount}}){{/if}}</button><button type="button" data-action="openImporter" data-import-mode="auto"><i class="fa-solid fa-file-import"></i> Import</button><button type="button" data-action="openExporter"><i class="fa-solid fa-file-export"></i> Export</button><button type="button" data-action="openNotebook"><i class="fa-solid fa-note-sticky"></i> GM Notes</button>{{/if}}
      </section>
      {{/if}}

      {{#if isGM}}<button type="button" class="at-settings-link" data-action="openSettings"><i class="fa-solid fa-gear"></i> Campaign Settings</button>{{/if}}
    </aside>
    {{/if}}

    <section class="at-hero">
      <div class="at-mobile-campaign">
        <span>{{settings.campaignTitle}}</span>
        <strong><i class="fa-solid fa-location-dot"></i> {{settings.currentLocation}}</strong>
      </div>
      <div class="at-hero-copy">
        <span class="at-kicker">Welcome back</span>
        <h1>{{settings.welcomeTitle}}</h1>
        <p>{{settings.welcomeText}}</p>
        {{#if settings.homeShowEnterButtonEffective}}<div class="at-hero-actions"><button type="button" class="at-primary at-home-enter" data-action="navigate" data-tab="{{settings.homeEnterTarget}}"><i class="fa-solid fa-arrow-right-to-bracket"></i> Enter {{settings.homeEnterTarget}}</button></div>{{/if}}
      </div>

      {{#if settings.homeAtGlanceEffective}}<div class="at-glance">
        <h3><i class="fa-solid fa-sparkles"></i> At a glance</h3>
        <div><span><i class="fa-solid fa-diamond"></i> Active Quests</span><strong>{{stats.activeQuests}}</strong></div>
        <div><span><i class="fa-solid fa-users"></i> Group Members</span><strong>{{stats.group}}</strong></div>
        <div><span><i class="fa-solid fa-earth-europe"></i> World Entries</span><strong>{{stats.world}}</strong></div>
        <div><span><i class="fa-solid fa-book-open"></i> Sessions</span><strong>{{stats.sessions}}</strong></div>
      </div>{{/if}}
    </section>

    {{#if settings.homeCardsVisible}}<section class="at-home-cards">
      {{#each homeBlocks}}
        {{#if isLatestSession}}
        <article class="at-card at-home-widget {{sizeClass}} at-latest-session-card">
          <div class="at-card-header"><span>Latest Session</span>{{#if ../settings.nav.sessions}}<button type="button" data-action="navigate" data-tab="sessions">View all</button>{{/if}}</div>
          {{#if ../latestSession}}
            <div class="at-home-session-meta">{{#if ../latestSession.sessionNumber}}<span>Session {{../latestSession.sessionNumber}}</span>{{/if}}<i class="fa-solid fa-book-open"></i></div>
            <h3>{{../latestSession.displayTitle}}</h3>
            <p class="at-clamp-3" title="{{../latestSession.summary}}">{{../latestSession.homeSummary}}</p>
            <button class="at-primary" type="button" data-action="selectSession" data-journal-id="{{../latestSession.id}}">View Session</button>
          {{else}}<div class="at-empty">No session journals found yet.</div>{{/if}}
        </article>
        {{/if}}

        {{#if isActiveQuests}}
        <article class="at-card at-home-widget {{sizeClass}}">
          <div class="at-card-header"><span>Active Quests</span>{{#if ../settings.nav.quests}}<button type="button" data-action="navigate" data-tab="quests">View all</button>{{/if}}</div>
          <div class="at-mini-list at-home-quest-list">
            {{#each ../homeQuests}}<button type="button" data-action="openQuestDetail" data-journal-id="{{id}}" title="{{summary}}"><i class="fa-solid {{#if featured}}fa-star{{else}}fa-diamond{{/if}}"></i><span><strong>{{name}}</strong><small>{{homeSummary}}</small></span></button>{{else}}<div class="at-empty">No active quest journals found.</div>{{/each}}
          </div>
        </article>
        {{/if}}

        {{#if isGroup}}
        <article class="at-card at-home-widget {{sizeClass}} at-group-preview">
          <div class="at-card-header"><span>The Group</span>{{#if ../settings.nav.group}}<button type="button" data-action="navigate" data-tab="group">View group</button>{{/if}}</div>
          <div class="at-portrait-row">
            {{#each ../homeGroup}}<button type="button" data-action="openProfile" data-actor-id="{{id}}" title="View {{name}} profile"><img src="{{img}}" alt="{{name}}"><strong>{{name}}</strong><small>{{displayRole}}</small></button>{{else}}<div class="at-empty">GM can add player characters in Campaign Settings.</div>{{/each}}
          </div>
        </article>
        {{/if}}

        {{#if isRecentWorld}}
        <article class="at-card at-home-widget {{sizeClass}}">
          <div class="at-card-header"><span>Recent Discoveries</span>{{#if ../settings.nav.world}}<button type="button" data-action="navigate" data-tab="world">View all</button>{{/if}}</div>
          <div class="at-mini-list">{{#each ../homeWorld}}<button type="button" data-action="openWorldProfile" data-journal-id="{{id}}"><i class="fa-solid fa-map-pin"></i><span><strong>{{name}}</strong><small>{{summary}}</small></span></button>{{else}}<div class="at-empty">World entries will appear here.</div>{{/each}}</div>
        </article>
        {{/if}}

        {{#if isCampaignSnapshot}}
        <article class="at-card at-home-widget {{sizeClass}} at-home-snapshot">
          <div class="at-card-header"><span>Campaign Snapshot</span><i class="fa-solid fa-chart-simple"></i></div>
          <div class="at-home-stat-grid"><div><strong>{{../stats.sessions}}</strong><span>Sessions</span></div><div><strong>{{../stats.activeQuests}}</strong><span>Active Quests</span></div><div><strong>{{../stats.group}}</strong><span>Group</span></div><div><strong>{{../stats.world}}</strong><span>World Entries</span></div></div>
        </article>
        {{/if}}

        {{#if isFavorites}}
        <article class="at-card at-home-widget {{sizeClass}}">
          <div class="at-card-header"><span>My Favorites</span>{{#if ../settings.nav.search}}<button type="button" data-action="navigate" data-tab="search">View all</button>{{/if}}</div>
          <div class="at-mini-list">{{#each ../searchState.favorites}}<button type="button" data-action="{{action}}" {{#if actor}}data-actor-id="{{id}}"{{else}}data-journal-id="{{id}}"{{/if}} data-ref-key="{{refKey}}"><i class="fa-solid {{icon}}"></i><span><strong>{{name}}</strong><small>{{category}} · {{meta}}</small></span></button>{{else}}<div class="at-empty">Favorite entries appear here for each user.</div>{{/each}}</div>
        </article>
        {{/if}}

        {{#if isGmTools}}
        {{#if ../isGM}}<article class="at-card at-home-widget {{sizeClass}} at-home-gm-tools">
          <div class="at-card-header"><span>GM Tools</span><i class="fa-solid fa-wand-magic-sparkles"></i></div>
          <div class="at-home-tool-grid"><button type="button" data-action="openGmDashboard"><i class="fa-solid fa-calendar-check"></i><span>Next Session</span></button><button type="button" data-action="openQuickCapture"><i class="fa-solid fa-bolt"></i><span>Quick Capture</span></button><button type="button" data-action="openRevealQueue"><i class="fa-solid fa-eye"></i><span>Reveal Queue</span></button><button type="button" data-action="openPostSession"><i class="fa-solid fa-flag-checkered"></i><span>Post-Session</span></button></div>
        </article>{{/if}}
        {{/if}}
      {{else}}
        <article class="at-card"><div class="at-empty">No Home dashboard blocks are enabled. The GM can enable them in Campaign Settings.</div></article>
      {{/each}}
    </section>{{/if}}
  </main>
  {{/if}}

  {{#if isSessions}}
  <main class="at-page at-sessions-page">
    <section class="at-page-heading at-page-heading-actions"><div><span class="at-kicker">Chronicle</span><h1>Sessions</h1><p>Your campaign history, one chapter at a time.</p></div><div class="at-page-tools"><div class="at-local-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" data-at-local-search="sessions" placeholder="Search Sessions…"></div>{{#if isGM}}<button type="button" class="at-secondary" data-action="openImporter" data-import-mode="session"><i class="fa-solid fa-file-import"></i> Import Session</button>{{/if}}</div></section>
    <section class="at-session-workspace">
      <section class="at-session-master" aria-label="Campaign session history">
        <div class="at-session-chronicle">
          {{#each sessions}}
          <button type="button" class="at-session-row {{#if selected}}is-selected{{/if}}" data-action="selectSession" data-journal-id="{{id}}" title="{{summary}}" data-at-local-search-row="sessions" data-local-search-text="{{localSearchText}}">
            <span class="at-session-marker">{{#if sessionNumber}}{{sessionNumber}}{{else}}<i class="fa-solid fa-book-open"></i>{{/if}}</span>
            <span class="at-session-content">
              <span class="at-session-eyebrow">{{#if sessionNumber}}Session {{sessionNumber}}{{else}}Chronicle entry{{/if}}</span>
              <strong>{{displayTitle}}</strong>
              <small class="at-clamp-2">{{listSummary}}</small>
            </span>
            <i class="fa-solid fa-chevron-right"></i>
          </button>
          {{else}}<div class="at-empty at-wide">No session journals yet. Put Journal Entries in Adventurer's Tome → Sessions.</div>{{/each}}
        </div>
      </section>

      {{#if selectedSession}}
      <aside class="at-session-detail">
        <header class="at-session-detail-head">
          <div class="at-session-detail-number">{{#if selectedSession.sessionNumber}}{{selectedSession.sessionNumber}}{{else}}<i class="fa-solid fa-book-open"></i>{{/if}}</div>
          <div>
            <span class="at-kicker">{{#if selectedSession.sessionNumber}}Session {{selectedSession.sessionNumber}}{{else}}Chronicle entry{{/if}}</span>
            <h2>{{selectedSession.displayTitle}}</h2>
          </div>
          {{#if isGM}}<button type="button" class="at-access-icon" data-action="queueReveal" data-ref-key="{{selectedSession.refKey}}" title="Add to Reveal Queue"><i class="fa-solid fa-eye-low-vision"></i></button><button type="button" class="at-access-icon" data-action="showToPlayers" data-ref-key="{{selectedSession.refKey}}" title="Show to Players"><i class="fa-solid fa-bullhorn"></i></button><button type="button" class="at-access-icon" data-action="quickNote" data-document-type="journal" data-document-id="{{selectedSession.id}}" title="GM Notes"><i class="fa-solid fa-note-sticky"></i></button><button type="button" class="at-access-icon" data-action="editAccess" data-document-type="journal" data-document-id="{{selectedSession.id}}" title="Tome permissions"><i class="fa-solid fa-shield-halved"></i></button>{{/if}}<button type="button" class="at-favorite-icon {{#if selectedSession.isFavorite}}is-favorite{{/if}}" data-action="toggleFavorite" data-ref-key="{{selectedSession.refKey}}" title="{{#if selectedSession.isFavorite}}Remove from favorites{{else}}Add to favorites{{/if}}"><i class="{{#if selectedSession.isFavorite}}fa-solid{{else}}fa-regular{{/if}} fa-star"></i></button>
        </header>

        <p class="at-session-detail-summary">{{selectedSession.summary}}</p>{{#if isGM}}{{#if selectedSession.access.restricted}}<div class="at-access-badges">{{#if selectedSession.access.gmOnly}}<span><i class="fa-solid fa-lock"></i> GM only</span>{{/if}}{{#if selectedSession.access.undiscovered}}<span><i class="fa-solid fa-eye-slash"></i> Undiscovered</span>{{/if}}</div>{{/if}}{{#if selectedSession.access.openNotes.length}}<div class="at-gm-note-stack">{{#each selectedSession.access.openNotes}}<div class="at-gm-note {{#if pinned}}is-pinned{{/if}}"><i class="fa-solid {{typeIcon}}"></i><div><strong>{{typeLabel}} · {{title}}</strong><p>{{body}}</p>{{#if trigger}}<small><i class="fa-solid fa-bell"></i> {{trigger}}</small>{{/if}}{{#if sessionTarget}}<small><i class="fa-solid fa-calendar"></i> Session {{sessionTarget}}</small>{{/if}}</div></div>{{/each}}</div>{{/if}}{{/if}}

        <div class="at-session-detail-stats">
          <span><i class="fa-solid fa-diamond"></i><strong>{{selectedSession.questLinks.length}}</strong> Quest links</span>
          <span><i class="fa-solid fa-earth-europe"></i><strong>{{selectedSession.worldLinks.length}}</strong> World links</span>
          <span><i class="fa-solid fa-users"></i><strong>{{selectedSession.actorLinks.length}}</strong> Character links</span>
        </div>

        {{#if selectedSession.hasHighlights}}
        <section class="at-session-detail-section">
          <h3><i class="fa-solid fa-sparkles"></i> Highlights</h3>
          <ul class="at-session-highlights">
            {{#each selectedSession.highlights}}<li>{{this}}</li>{{/each}}
          </ul>
        </section>
        {{/if}}

        {{#if selectedSession.hasQuestLinks}}
        <section class="at-session-detail-section">
          <h3><i class="fa-solid fa-diamond"></i> Quest threads</h3>
          <div class="at-session-link-grid">
            {{#each selectedSession.questLinks}}
            <button type="button" class="at-session-link-card" data-action="openQuestDetail" data-journal-id="{{id}}">
              <span><i class="fa-solid fa-diamond"></i>{{name}}</span><small>{{statusLabel}}</small>
            </button>
            {{/each}}
          </div>
        </section>
        {{/if}}

        {{#if selectedSession.hasWorldLinks}}
        <section class="at-session-detail-section">
          <h3><i class="fa-solid fa-earth-europe"></i> People, places & lore</h3>
          <div class="at-session-link-grid">
            {{#each selectedSession.worldLinks}}
            <button type="button" class="at-session-link-card" data-action="openWorldProfile" data-journal-id="{{id}}">
              <span><i class="fa-solid {{icon}}"></i>{{name}}</span><small>{{categoryLabel}}</small>
            </button>
            {{/each}}
          </div>
        </section>
        {{/if}}

        {{#if selectedSession.hasActorLinks}}
        <section class="at-session-detail-section">
          <h3><i class="fa-solid fa-users"></i> Characters</h3>
          <div class="at-session-link-grid">
            {{#each selectedSession.actorLinks}}
            <button type="button" class="at-session-link-card" data-action="openProfile" data-actor-id="{{id}}">
              <span><i class="fa-solid fa-user"></i>{{name}}</span><small>{{displayRole}}</small>
            </button>
            {{/each}}
          </div>
        </section>
        {{/if}}

        <section class="at-session-detail-section at-session-detail-notes at-shareable-text">
          <h3><i class="fa-solid fa-book-open"></i> Chronicle excerpt</h3>
          <p>{{selectedSession.bodyPreview}}</p>
        </section>

        <button type="button" class="at-primary at-session-open-full" data-action="openJournal" data-journal-id="{{selectedSession.id}}"><i class="fa-solid fa-book-open"></i> Open Full Session</button>
      </aside>
      {{/if}}
    </section>
  </main>
  {{/if}}

  {{#if isQuests}}
  <main class="at-page at-quests-page">
    <section class="at-page-heading at-page-heading-actions"><div><span class="at-kicker">Threads of the tale</span><h1>Quests</h1><p>Active goals, unfinished business, and completed deeds.</p></div><div class="at-page-tools"><div class="at-local-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" data-at-local-search="quests" placeholder="Search Quests…"></div>{{#if isGM}}<button type="button" class="at-secondary" data-action="openImporter" data-import-mode="quest"><i class="fa-solid fa-file-import"></i> Import Quest Log</button>{{/if}}</div></section>
    <section class="at-quest-groups">
      {{#each questGroups}}
      <section class="at-quest-group at-quest-group-{{id}}">
        <header>
          <div><i class="fa-solid {{icon}}"></i><h2>{{label}}</h2></div>
          <span>{{count}}</span>
        </header>
        <div class="at-quest-grid">
          {{#each entries}}
          <button type="button" class="at-quest-card" data-action="openQuestDetail" data-journal-id="{{id}}" title="{{summary}}" data-at-local-search-row="quests" data-local-search-text="{{localSearchText}}">
            <div class="at-quest-card-top">
              <span class="at-quest-status at-status-{{status}}">{{statusLabel}}</span>
              {{#if featured}}<i class="fa-solid fa-star" title="Featured quest"></i>{{/if}}
            </div>
            <strong>{{name}}</strong>
            <small class="at-clamp-3">{{listSummary}}</small>
            <span class="at-quest-open">Open quest <i class="fa-solid fa-arrow-right"></i></span>
          </button>
          {{/each}}
        </div>
      </section>
      {{else}}<div class="at-empty at-wide">No quest journals yet. Put Journal Entries in Adventurer's Tome → Quests.</div>{{/each}}
    </section>
  </main>
  {{/if}}


  {{#if isQuestDetail}}
  <main class="at-page at-quest-detail-page">
    <section class="at-profile-toolbar at-detail-toolbar">
      <div class="at-detail-nav">
        <button type="button" class="at-secondary at-back-button" data-action="goBack"><i class="fa-solid fa-arrow-left"></i> Back</button>
        <nav class="at-breadcrumbs" aria-label="Breadcrumb"><button type="button" data-action="navigate" data-tab="home">Home</button><i class="fa-solid fa-chevron-right"></i><button type="button" data-action="navigate" data-tab="quests">Quests</button><i class="fa-solid fa-chevron-right"></i><span>{{questDetail.name}}</span></nav>
      </div>
      <div class="at-profile-toolbar-actions">{{#if isGM}}<button type="button" class="at-secondary" data-action="queueReveal" data-ref-key="{{questDetail.refKey}}"><i class="fa-solid fa-eye-low-vision"></i> Queue Reveal</button><button type="button" class="at-secondary" data-action="showToPlayers" data-ref-key="{{questDetail.refKey}}"><i class="fa-solid fa-bullhorn"></i> Show to Players</button><button type="button" class="at-secondary" data-action="quickNote" data-document-type="journal" data-document-id="{{questDetail.id}}"><i class="fa-solid fa-note-sticky"></i> GM Note</button><button type="button" class="at-secondary" data-action="editAccess" data-document-type="journal" data-document-id="{{questDetail.id}}"><i class="fa-solid fa-shield-halved"></i> Permissions</button>{{/if}}<button type="button" class="at-secondary at-favorite-button {{#if questDetail.isFavorite}}is-favorite{{/if}}" data-action="toggleFavorite" data-ref-key="{{questDetail.refKey}}"><i class="{{#if questDetail.isFavorite}}fa-solid{{else}}fa-regular{{/if}} fa-star"></i> {{#if questDetail.isFavorite}}Favorited{{else}}Favorite{{/if}}</button><button type="button" class="at-secondary" data-action="openJournal" data-journal-id="{{questDetail.id}}" data-ref-key="{{questDetail.refKey}}"><i class="fa-solid fa-book-open"></i> Open Quest Journal</button></div>
    </section>
    <section class="at-quest-detail-hero">
      <div>
        <div class="at-quest-detail-meta"><span class="at-quest-status at-status-{{questDetail.status}}">{{questDetail.statusLabel}}</span>{{#if questDetail.featured}}<span class="at-featured-badge"><i class="fa-solid fa-star"></i> Featured</span>{{/if}}</div>
        <span class="at-kicker">Quest thread</span>
        <h1>{{questDetail.name}}</h1>
        <p>{{questDetail.summary}}</p>{{#if isGM}}{{#if questDetail.access.restricted}}<div class="at-access-badges">{{#if questDetail.access.gmOnly}}<span><i class="fa-solid fa-lock"></i> GM only</span>{{/if}}{{#if questDetail.access.undiscovered}}<span><i class="fa-solid fa-eye-slash"></i> Undiscovered</span>{{/if}}</div>{{/if}}{{/if}}
      </div>
      <aside class="at-quest-detail-glance">
        <div><span>Sessions</span><strong>{{questDetail.sessionLinks.length}}</strong></div>
        <div><span>World</span><strong>{{questDetail.worldLinks.length}}</strong></div>
        <div><span>Characters</span><strong>{{questDetail.actorLinks.length}}</strong></div>
