    {{#if isGM}}<section class="at-settings-card at-rule-tools"><div><h2><i class="fa-solid fa-plus"></i> Rule Tools</h2><p>Create a new Foundry Journal rule or link an existing Journal into Tome Rules.</p></div><div class="at-rule-tool-grid"><label>New rule<input type="text" name="newRuleName" placeholder="Travel — Forced March"></label><button type="button" class="at-primary" data-action="createRule"><i class="fa-solid fa-file-circle-plus"></i> Create Rule</button><label>Existing Journal<select name="existingRuleJournalId"><option value="">Choose Journal…</option>{{#each ruleLinkCandidates}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><button type="button" class="at-secondary" data-action="linkRule"><i class="fa-solid fa-link"></i> Link Existing</button></div></section>{{/if}}
